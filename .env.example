# Copy to .env (git-ignored) and fill in. Never commit real values.

# Alpaca Market Data API keys (free "Basic" plan, from a paper-only account). Leave empty to run on
# synthetic demo data only.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# iex is the only feed a paper-only account is entitled to.
ALPACA_FEED=iex

# Tickers the daily job keeps up to date (comma-separated).
# INGEST_SYMBOLS=SPY,QQQ,AAPL,MSFT

# Database (defaults match docker-compose.yml).
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/marketdata
# SPRING_DATASOURCE_USERNAME=marketdata
# SPRING_DATASOURCE_PASSWORD=marketdata
