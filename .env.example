# Copy to .env (git-ignored) and fill in. Never commit real values.

# Alpaca Market Data API keys (free "Basic" plan, from a paper-only account). Leave empty to run on
# synthetic demo data only.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# iex is the only feed a paper-only account is entitled to.
ALPACA_FEED=iex

# Tickers the daily job keeps up to date (comma-separated).
# INGEST_SYMBOLS=SPY,QQQ,AAPL,MSFT

# Database (defaults match docker-compose.yml).
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/marketdata
# SPRING_DATASOURCE_USERNAME=marketdata
# SPRING_DATASOURCE_PASSWORD=marketdata

# API keys, as SHA-256 hex digests only. Generate a key and its digest:
#   KEY=$(openssl rand -hex 32); printf %s "$KEY" | shasum -a 256
# API_KEYS: <digest>:<scope>[,<scope>] entries separated by semicolons. Scopes: rate-limit (not rate-limited),
# alpaca-data (every data source, not just PUBLIC_DATA_SOURCES), export (/v1/export).
# API_KEYS=<tradedesk digest>:rate-limit;<quant digest>:rate-limit,alpaca-data,export
# API_KEY_SHA256: the original setting, comma-separated digests of keys that get every scope. To limit a key, move
# its digest to API_KEYS (a digest in both is a startup error).
# API_KEY_SHA256=

# Public endpoints serve these sources without a key. Keep "synthetic" until Alpaca has given written
# consent to display its data publicly; then alpaca,synthetic.
# PUBLIC_DATA_SOURCES=synthetic

# Synthetic demo data: never | when-no-keys | always
# DEMO_SEED=when-no-keys
# DEMO_SYMBOLS=50

# Only when the chart explorer is hosted on another origin.
# CORS_ALLOWED_ORIGINS=https://example.pages.dev
